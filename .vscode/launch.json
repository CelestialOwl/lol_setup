{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go: Launch Server (local)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/server/cmd/server",
            "cwd": "${workspaceFolder}/server",
            "envFile": "${workspaceFolder}/server/.env"
        },
        {
            "name": "Go: Attach to Docker (remote Delve)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "debugAdapter": "legacy",
            "substitutePath": [
                {
                    "from": "${workspaceFolder}/server",
                    "to": "/app"
                }
            ],
            "port": 2345,
            "host": "127.0.0.1"
        }
    ]
}